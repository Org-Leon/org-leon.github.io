    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "@turf/turf": "^7.4.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "gridstack": "^14.0.0",
